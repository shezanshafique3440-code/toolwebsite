{
  "name": "productpilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ProductPilot AI \u2014 AI-powered e-commerce product research and analysis platform.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./scripts/register-aliases.mjs \"tests/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types --import ./scripts/register-aliases.mjs prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --experimental-strip-types --import ./scripts/register-aliases.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "6.16.2",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toast": "1.2.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "lucide-react": "0.451.0",
    "next": "15.5.4",
    "openai": "^7.10.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.7.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.12.0",
    "eslint-config-next": "15.5.4",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.6.3"
  }
}
