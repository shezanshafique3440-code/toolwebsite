# ---------------------------------------------------------------------------
# ProductPilot AI — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productpilot?schema=public"

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""

# Public origin of the deployment. Used for links in emails, canonical URLs,
# the sitemap, and the CSRF origin check.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- AI providers ---------------------------------------------------------
# Keys are read on the server only and are never exposed to the browser.
# With no key set, the app runs in demo mode: every generated result is
# clearly labelled as sample output rather than a model response.

# "auto" (default) prefers Anthropic, then OpenAI, then the offline demo
# provider. Set to "anthropic", "openai" or "demo" to pin one.
AI_PROVIDER="auto"

ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5. Set a cheaper model here to trade depth for cost.
ANTHROPIC_MODEL=""

OPENAI_API_KEY=""
# Defaults to gpt-4o-mini.
OPENAI_MODEL=""

# Optional: per-million-token rates used for the admin cost dashboard.
# ANTHROPIC_INPUT_COST_PER_MTOK="5"
# ANTHROPIC_OUTPUT_COST_PER_MTOK="25"
# OPENAI_INPUT_COST_PER_MTOK="0.15"
# OPENAI_OUTPUT_COST_PER_MTOK="0.6"


# --- Billing: Paddle ------------------------------------------------------
# Without these the billing page reports that payments are unavailable. It never
# falls back to granting a paid plan: only a signature-verified Paddle webhook
# can change a subscription.
#
# API key and webhook secret are server-side only and must never reach the
# browser. PADDLE_CLIENT_TOKEN is the one value that is safe to expose — Paddle
# publishes it to open the checkout.

# "sandbox" while testing, "production" when going live. They are separate
# Paddle accounts with separate credentials and separate price IDs.
PADDLE_ENVIRONMENT="sandbox"

# Paddle > Developer tools > Authentication > API keys  (starts with "pdl_")
PADDLE_API_KEY=""

# Paddle > Developer tools > Authentication > Client-side tokens ("live_"/"test_")
PADDLE_CLIENT_TOKEN=""

# Shown once when you create the notification destination in
# Paddle > Developer tools > Notifications  (starts with "pdl_ntfset_")
PADDLE_WEBHOOK_SECRET=""

# Paddle > Catalog > Products > (your product) > Prices — copy the price IDs
# ("pri_..."). These must match the plans in src/lib/plans.ts:
#   Pro      $19/month
#   Business $49/month
PADDLE_PRO_PRICE_ID=""
PADDLE_BUSINESS_PRICE_ID=""


# --- Security (optional) --------------------------------------------------
# Extra origins allowed to make state-changing requests, comma separated.
# ALLOWED_ORIGINS="https://app.example.com"
