# ---------------------------------------------------------------------------
# ProductPilot AI — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productpilot?schema=public"

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""

# Public origin of the deployment. Used for links in emails, canonical URLs,
# the sitemap, and the CSRF origin check.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- AI providers ---------------------------------------------------------
# Keys are read on the server only and are never exposed to the browser.
# With no key set, the app runs in demo mode: every generated result is
# clearly labelled as sample output rather than a model response.

# "auto" (default) prefers Anthropic, then OpenAI, then the offline demo
# provider. Set to "anthropic", "openai" or "demo" to pin one.
AI_PROVIDER="auto"

ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5. Set a cheaper model here to trade depth for cost.
ANTHROPIC_MODEL=""

OPENAI_API_KEY=""
# Defaults to gpt-4o-mini.
OPENAI_MODEL=""

# Optional: per-million-token rates used for the admin cost dashboard.
# ANTHROPIC_INPUT_COST_PER_MTOK="5"
# ANTHROPIC_OUTPUT_COST_PER_MTOK="25"
# OPENAI_INPUT_COST_PER_MTOK="0.15"
# OPENAI_OUTPUT_COST_PER_MTOK="0.6"


# --- Billing (optional) ---------------------------------------------------
# Until a processor is connected, plan changes are applied directly and nothing
# is charged; the billing UI states this. See src/lib/billing/service.ts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""


# --- Security (optional) --------------------------------------------------
# Extra origins allowed to make state-changing requests, comma separated.
# ALLOWED_ORIGINS="https://app.example.com"
